# Copy to .env for a local deployment. Never put secrets in browser code.
NODE_ENV=development
PORT=4173
HOST=127.0.0.1
DATA_DIR=./data
PRIVATE_STORAGE_DIR=./storage
SESSION_TTL_HOURS=8

# First account creation is enabled only while the users table is empty.
# Keep the service reachable only by trusted administrators during setup.

# Optional OCR provider contract. Without both values, documents enter manual review.
OCR_PROVIDER_URL=
OCR_PROVIDER_TOKEN=

# Optional authorized source-verification provider contract.
VERIFICATION_PROVIDER_URL=
VERIFICATION_PROVIDER_TOKEN=

# Gemini API generateContent endpoint for Pramaan Sahayak.
# Keep the API key in the server environment; messages and selected case summaries are sent to Google Gemini.
AI_ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=gemini-3.5-flash-lite

# Optional AICTE system-to-system integration. This is a service secret, never a UI credential.
AICTE_SERVICE_TOKEN=

# These values configure visible product branding without code changes.
BRAND_NAME=pramaan
ORGANIZATION_NAME=Institutional Verification Workspace
SUPPORT_EMAIL=
